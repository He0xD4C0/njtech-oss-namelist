# Copy into NginxUI as a new site, replace all placeholders and select its actual certificate paths.
# The separate default deny configuration remains enabled. Never proxy a public site to port 9000.
server {
    listen 80;
    server_name SITE_DOMAIN;
    location /.well-known/acme-challenge/ { root /var/www; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name SITE_DOMAIN;
    ssl_certificate CERTIFICATE_FULLCHAIN_PATH;
    ssl_certificate_key CERTIFICATE_PRIVATE_KEY_PATH;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    client_max_body_size 10m;
    # Choose production-web / production-static or staging-web / staging-static.
    set $application ENVIRONMENT-web:8000;
    set $assets ENVIRONMENT-static:8080;
    location /static/ {
        proxy_pass http://$assets;
        proxy_set_header Host $host;
    }
    location / {
        proxy_pass http://$application;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite client-supplied forwarding headers; do not append untrusted chains.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }
}
