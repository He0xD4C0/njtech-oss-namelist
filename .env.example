# Copy separately to /srv/namelist/staging/runtime.env and production/runtime.env.
# Never commit either file or the contents of SECRET_DIR.
COMPOSE_PROJECT_NAME=namelist-staging
SITE_ENVIRONMENT=staging
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=staging.example.invalid
CSRF_TRUSTED_ORIGINS=https://staging.example.invalid
SITE_BASE_URL=https://staging.example.invalid
SOURCE_REPOSITORY_URL=https://github.com/OWNER/njtech-oss-namelist
TRUST_EDGE_CLIENT_IP=1
POSTGRES_DB=namelist
POSTGRES_USER=namelist
SECRET_DIR=/srv/namelist/staging/secrets
# Release automation replaces these with @sha256 references; never use :latest in deployments.
APP_IMAGE=ghcr.io/OWNER/njtech-oss-namelist-web@sha256:REPLACE
SCANNER_IMAGE=ghcr.io/OWNER/njtech-oss-namelist-scanner@sha256:REPLACE
MAINTENANCE_IMAGE=ghcr.io/OWNER/njtech-oss-namelist-maintenance@sha256:REPLACE
POSTGRES_BACKUP_IMAGE=ghcr.io/OWNER/njtech-oss-namelist-postgres@sha256:REPLACE
STATIC_IMAGE=ghcr.io/OWNER/njtech-oss-namelist-static@sha256:REPLACE
SCAN_CONCURRENCY=1
SCAN_MEMORY=12g
SCAN_CPUS=2
WORKER_CONCURRENCY=2
BACKUP_ENABLED=1
BACKUP_REPO_TYPE=s3
BACKUP_REPO_PATH=/namelist/staging
BACKUP_S3_ENDPOINT=s3.example.invalid
BACKUP_S3_BUCKET=namelist-backup
BACKUP_S3_REGION=us-east-1
BACKUP_S3_URI_STYLE=path
RESTORE_TIMEOUT_SECONDS=14400
# production: project namelist-production, SITE_ENVIRONMENT=production,
# distinct SECRET_DIR/domain/OAuth/SMTP/storage configs and backup path,
# SCAN_CONCURRENCY=2, SCAN_MEMORY=16g, SCAN_CPUS=4, WORKER_CONCURRENCY=4.
